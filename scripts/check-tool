#!/usr/bin/env bash
# Gates for 007's own bootstrap tool, bin/007. Not copied to projects.
# Reuses the hooks' pinned tools and config files.
set -euo pipefail

TOOLS=(--no-project --with ruff==0.16.9 --with mypy==2.3.1 --with pytest==9.1.1)

uv run "${TOOLS[@]}" ruff check --config .claude/hooks/ruff.toml bin/007 bin/tests
uv run "${TOOLS[@]}" ruff format --check --config .claude/hooks/ruff.toml bin/007 bin/tests
uv run "${TOOLS[@]}" mypy --config-file .claude/hooks/mypy.ini bin/007 bin/tests
uv run "${TOOLS[@]}" pytest -c .claude/hooks/pytest.ini -p no:cacheprovider \
  bin/tests "$@"
